# ============================================================
# EzQueue Monorepo Root Environment Configuration Template
# ============================================================
# Copy appropriate sections into:
#   - apps/web/.env (Client Vite Application - PUBLIC only)
#   - apps/api/.env (Backend Express Service - SERVER-ONLY & CONFIG)

# ============================================================
# [SERVER-ONLY] Backend API Configuration (apps/api/.env)
# ============================================================
PORT=4000
NODE_ENV=production
CLIENT_URL=https://your-frontend.vercel.app

# Supabase Credentials (from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Internal JWT signing key (min 32 characters)
JWT_SECRET=super-secret-jwt-key-minimum-32-characters-long

# Initial Bootstrap Organization Owner (server-side verified)
BOOTSTRAP_ADMIN_EMAIL=owner@example.com

# ============================================================
# [PUBLIC] Frontend Web Application Configuration (apps/web/.env)
# ============================================================
# Backend API Base Endpoint
VITE_API_URL=https://your-api.onrender.com/api/v1
VITE_API_BASE_URL=https://your-api.onrender.com/api/v1

# Supabase Public Configuration (SAFE for browser bundles)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
