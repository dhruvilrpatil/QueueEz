# ============================================================
# EzQueue Express API Environment Variables
# ============================================================

# Server Port & Environment
PORT=4000
NODE_ENV=development

# Allowed Client URLs (CORS) - Comma-separated for multiple origins
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app

# Supabase Credentials (from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Secret
JWT_SECRET=super-secret-jwt-key-minimum-32-characters-long

# Initial Organization Owner / Bootstrap Administrator (Server-Only)
# Optional: Set this to the email of the designated bootstrap owner for server-side role elevation
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
