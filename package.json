{
  "name": "ezqueue",
  "version": "1.0.0",
  "private": true,
  "description": "EzQueue – Smart Appointment & Virtual Queue Management System",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
